# Copy to terraform.tfvars and edit.
# terraform.tfvars is gitignored. Never commit it.

region              = "us-east-1"
owner_email         = "you@example.com"
allowed_source_cidr = "203.0.113.42/32"   # your /32, replace me

# Optional. Leave empty to skip SNS wiring.
notify_sns_topic_arn = ""

# Leave the token default unless you want to test a specific value.
# fake_oauth_refresh_token = "1//0f-FAKE-REFRESH-TOKEN-..."
